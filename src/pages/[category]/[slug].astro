---
import PostLayout from '../../layouts/PostLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { categories } from '../../utils/categories';
import { getCollection, render } from 'astro:content';
import type { CategorySlug } from '../../utils/categories';

export async function getStaticPaths() {
  const paths = [];
  for (const cat of categories) {
    const posts = await getCollection('articles', (p) => p.data.category === cat.slug);
    for (const post of posts) {
      paths.push({
        params: { category: cat.slug, slug: post.id },
        props: { post, categorySlug: cat.slug },
      });
    }
  }
  return paths;
}

const { post, categorySlug } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('articles', (p) => p.data.category === categorySlug && p.id !== post.id);
const relatedPosts = allPosts.sort(() => Math.random() - 0.5).slice(0, 3);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date instanceof Date ? post.data.date : new Date(post.data.date)}
  image={post.data.image}
  author={post.data.author}
  tags={post.data.tags}
  category={categorySlug}
>
  <Content />

  {relatedPosts.length > 0 && (
    <div class="mt-16 pt-10 border-t border-gray-100">
      <h2 class="font-serif text-2xl font-semibold text-gray-900 mb-6">Свързани статии:</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {relatedPosts.map((related) => (
          <PostCard post={related} />
        ))}
      </div>
    </div>
  )}
</PostLayout>
