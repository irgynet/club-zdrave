---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { isLocalImage, getImageSrc } from '../../utils/image';
import OfferCard from '../../components/OfferCard.astro';

export async function getStaticPaths() {
  const offers = await getCollection('offers');
  return offers.map((offer) => ({
    params: { slug: offer.id },
    props: { offer },
  }));
}

const { offer } = Astro.props;
const { title, description, image, price, brand, affiliateLink, date } = offer.data;
const { Content } = await render(offer);
const formattedDate = new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const useLocal = isLocalImage(image as any);
const ogImage = getImageSrc(image as any);

const relatedOffers = (await getCollection('offers'))
  .filter((o) => o.data.brand === brand && o.id !== offer.id)
  .slice(0, 3);
---

<Layout title={title} description={description} image={ogImage}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <a href="/produkti" class="inline-flex items-center gap-1 text-teal-600 hover:text-teal-700 text-sm font-medium mb-6 transition-colors">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Обратно към продуктите
    </a>

    <div class="mb-6 flex flex-wrap items-center gap-3">
      <span class="bg-teal-100 text-teal-700 text-xs font-semibold px-3 py-1 rounded-full">{brand}</span>
      <span class="text-gray-400 text-sm">{formattedDate}</span>
    </div>

    <h1 class="font-serif text-3xl md:text-4xl font-bold text-gray-900 mb-4">{title}</h1>
    
    <div class="rounded-2xl overflow-hidden mb-10">
      {useLocal ? (
        <Image
          src={image as any}
          alt={title}
          widths={[600, 1200, 1600]}
          sizes="(min-width: 1024px) 1024px, 100vw"
          class="w-full aspect-[16/9] object-cover"
        />
      ) : (
        <img src={image as string} alt={title} class="w-full aspect-[16/9] object-cover" />
      )}
    </div>

    <div class="prose prose-lg max-w-none prose-headings:font-serif prose-a:text-teal-600">
      <Content />
    </div>
    <div class="flex flex-wrap items-center gap-4 mt-8">
      <span class="text-2xl font-bold text-gray-900">{price}</span>
      <a
        href={affiliateLink}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="inline-flex items-center gap-1.5 bg-teal-600 hover:bg-teal-700 text-white font-medium px-5 py-2.5 rounded-lg transition-colors"
      >
        Купи от Ревита
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </article>
{relatedOffers.length > 0 && (
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <h2 class="font-serif text-2xl font-semibold text-gray-900 mb-6">Още продукти от {brand}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {relatedOffers.map((related) => (
        <OfferCard offer={related} />
      ))}
    </div>
  </div>
)}
</Layout>
