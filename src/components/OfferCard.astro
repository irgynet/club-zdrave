---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { isLocalImage } from '../utils/image';
interface Props {
  offer: CollectionEntry<'offers'>;
}

const { offer } = Astro.props;
const { title, description, image, price, brand, affiliateLink } = offer.data;
const useLocal = isLocalImage(image as any);
---

<article class="group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-300">
  <a href={`/produkti/${offer.id}`} class="block">
    <div class="relative aspect-[16/10] overflow-hidden">
      {useLocal ? (
        <Image
          src={image as any}
          alt={title}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      ) : (
        <img
          src={image as string}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
      )}
      <div class="absolute top-3 left-3 flex gap-2">
        <span class="bg-teal-600 text-white text-xs font-semibold px-2.5 py-1 rounded-full">{brand}</span>
      </div>
      <div class="absolute top-3 right-3">
        <span class="bg-white/90 backdrop-blur-sm text-gray-900 text-sm font-bold px-3 py-1 rounded-full">{price}</span>
      </div>
    </div>
  </a>
  <div class="p-5">
    <a href={`/produkti/${offer.id}`}>
      <h3 class="font-serif text-lg font-bold text-gray-900 mb-2 group-hover:text-teal-700 transition-colors line-clamp-2">{title}</h3>
    </a>
    <p class="text-gray-500 text-sm line-clamp-2 mb-4">{description}</p>
    <a
      href={affiliateLink}
      target="_blank"
      rel="noopener noreferrer nofollow"
      class="inline-flex items-center gap-1.5 bg-teal-600 hover:bg-teal-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors"
    >
      Вижте в Ревита
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</article>
