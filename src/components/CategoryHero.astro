---
import type { CategoryMeta } from '../utils/categories';

interface Props {
  category: CategoryMeta;
  postCount: number;
}

const { category, postCount } = Astro.props;
---

<section class="relative h-72 md:h-96 overflow-hidden">
  <img
    src={category.heroImage}
    alt={category.label}
    class="w-full h-full object-cover"
    loading="eager"
  />
  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/40 to-black/10" />
  <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-white/15 backdrop-blur-sm text-white text-xs font-medium rounded-full border border-white/20 mb-4">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      {postCount} {postCount === 1 ? 'Статия' : 'Статии'}
    </div>
    <h1 class="font-serif text-4xl md:text-6xl text-white font-bold mb-4 drop-shadow-lg">
      {category.label}
    </h1>
    <p class="text-white/85 text-lg md:text-xl max-w-2xl font-light leading-relaxed">
      {category.description}
    </p>
  </div>
</section>
