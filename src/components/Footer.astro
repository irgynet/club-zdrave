---
import { categories } from '../utils/categories';
---

<footer class="bg-gray-950 text-white mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center">
           <img src="/favicon.ico" alt="Клуб Здраве фавикон" />
          </div>
          <span class="font-serif font-bold text-xl">Клуб Здраве</span>
        </a>
        <p class="text-gray-300 text-sm leading-relaxed">
          Полезни съвети и насоки за вашето здраве, здравословно тегло и хранене. 
        </p>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Отидете на</h3>
        <ul class="space-y-2">
          {categories.map((cat) => (
            <li>
              <a href={`/${cat.slug}`} class="text-gray-200 hover:text-teal-400 text-sm transition-colors">
                {cat.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-white mb-4 text-sm uppercase tracking-wider">Вижте</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-gray-200 hover:text-teal-400 text-sm transition-colors">Начало</a></li>

        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-gray-200 text-sm">
        &copy; {new Date().getFullYear()} Club Zdrave. Всички права запазени!
      </p>
      </div>
  </div>
</footer>
