---
import { Image } from 'astro:assets';
import type { MdPost } from '../utils/posts';
import { getPostUrl } from '../utils/posts';
import type { CategorySlug } from '../utils/categories';
import { getCategoryMeta } from '../utils/categories';

interface Props {
  post: MdPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

const url = getPostUrl(post);
const categoryMeta = getCategoryMeta(post.data.category as CategorySlug);
const categoryLabel = categoryMeta?.label ?? '';

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(post.data.date instanceof Date ? post.data.date : new Date(post.data.date));

const image = post.data.image;
---

{featured ? (
  <a href={url} class="group block relative overflow-hidden rounded-2xl shadow-md hover:shadow-xl transition-all duration-300 h-[460px]">
    <Image
      src={image}
      alt={post.data.title}
      widths={[400, 800, 1200]}
      sizes="(min-width: 768px) 800px, 100vw"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent" />
    <div class="absolute bottom-0 left-0 right-0 p-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-2.5 py-0.5 bg-teal-500/90 text-white text-xs font-semibold rounded-full uppercase tracking-wide">
          {categoryLabel}
        </span>
        <span class="text-white/60 text-xs">{formattedDate}</span>
      </div>
      <h3 class="font-serif text-2xl md:text-3xl text-white font-semibold leading-tight mb-2 group-hover:text-teal-200 transition-colors">
        {post.data.title}
      </h3>
      <p class="text-white/75 text-sm line-clamp-2 leading-relaxed">{post.data.description}</p>
    </div>
  </a>
) : (
  <a href={url} class="group flex flex-col bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md border border-gray-100 hover:border-teal-100 transition-all duration-300">
    <div class="relative h-52 overflow-hidden flex-shrink-0">
      <Image
        src={image}
        alt={post.data.title}
        widths={[300, 600, 900]}
        sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      <div class="absolute top-3 left-3">
        <span class="px-2.5 py-1 bg-white/90 backdrop-blur-sm text-teal-700 text-xs font-semibold rounded-full shadow-sm">
          {categoryLabel}
        </span>
      </div>
    </div>
    <div class="p-5 flex flex-col flex-1">
      <div class="flex items-center gap-2 text-xs text-gray-400 mb-3">
        <span>{formattedDate}</span>
        {post.data.tags.length > 0 && (
          <>
            <span>&bull;</span>
            <span class="text-teal-600">{post.data.tags[0]}</span>
          </>
        )}
      </div>
      <h3 class="font-serif text-lg text-gray-900 font-semibold leading-snug mb-2 group-hover:text-teal-700 transition-colors line-clamp-2">
        {post.data.title}
      </h3>
      <p class="text-gray-500 text-sm leading-relaxed line-clamp-3 flex-1">{post.data.description}</p>
      <div class="mt-4 flex items-center text-teal-600 text-sm font-medium">
        Прочети повече..
        <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>
)}
